# Environment Variables for SmartBazaar
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay Configuration (for payments)
# Get these from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SmartBazaar
NEXT_PUBLIC_APP_DESCRIPTION=The Art of Smart Shopping

# Email Configuration (Optional - for sending emails)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASS=your-email-password
SMTP_FROM=noreply@smartbazaar.com

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Feature Flags
NEXT_PUBLIC_ENABLE_VIRTUAL_TRYON=true
NEXT_PUBLIC_ENABLE_LIVE_SHOPPING=true
NEXT_PUBLIC_ENABLE_GROUP_BUYING=true
NEXT_PUBLIC_ENABLE_BARGAINING=true

# API Configuration
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRY_COUNT=3

# Database Configuration
DATABASE_URL=your-supabase-connection-string
